# Copie para .env (o .env NUNCA vai para o GitHub) e preencha.

# Chave da API da xAI (Grok). Sem ela, o provedor "auto" usa o baseline por regras.
XAI_API_KEY=

# Opcional: modelo usado pelo provedor grok (ex.: grok-3, grok-3-mini, grok-4).
# ANALISTA_MODELO=grok-3

# Opcional: caminho do banco SQLite (padrão: data/delivery.db).
# DELIVERY_DB=data/delivery.db
