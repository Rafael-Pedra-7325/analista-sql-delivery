# Copie para .env (o .env NUNCA vai para o GitHub) e preencha.

# Chave gratuita da API da Groq (console.groq.com). Sem ela, o provedor "auto" usa o baseline por regras.
GROQ_API_KEY=

# Opcional: modelo usado pelo provedor groq (ex.: llama-3.3-70b-versatile, llama-3.1-8b-instant).
# ANALISTA_MODELO=llama-3.3-70b-versatile

# Opcional: caminho do banco SQLite (padrão: data/delivery.db).
# DELIVERY_DB=data/delivery.db
